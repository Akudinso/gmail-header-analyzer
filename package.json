{
  "name": "gmail-header-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that automatically analyses the Gmail email you open: headers, sender IP, SPF/DKIM/DMARC, links and attachments.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-extension.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "update-psl": "node scripts/update-psl.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
